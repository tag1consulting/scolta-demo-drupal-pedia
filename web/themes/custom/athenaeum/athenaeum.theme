<?php

/**
 * @file
 * Athenaeum theme functions.
 */

use Drupal\node\NodeInterface;

/**
 * Implements hook_preprocess_node().
 */
function athenaeum_preprocess_node(&$variables) {
  $node = $variables['node'];
  if ($node instanceof NodeInterface && $node->bundle() === 'featured_article') {
    if ($node->hasField('field_word_count') && !$node->get('field_word_count')->isEmpty()) {
      $word_count = $node->get('field_word_count')->value;
      $variables['reading_minutes'] = max(1, round($word_count / 200));
    }
    if ($node->hasField('field_topics') && !$node->get('field_topics')->isEmpty()) {
      $topics = [];
      foreach ($node->get('field_topics') as $topic_ref) {
        if ($term = $topic_ref->entity) {
          $topics[] = [
            'name' => $term->getName(),
            'url' => '/topic/' . strtolower($term->getName()),
          ];
        }
      }
      $variables['topic_list'] = $topics;
    }
  }

  if ($node instanceof NodeInterface && $node->bundle() === 'topic_landing_page') {
    if ($node->hasField('field_topic') && !$node->get('field_topic')->isEmpty()) {
      $term = $node->get('field_topic')->entity;
      if ($term && \Drupal::moduleHandler()->moduleExists('views')) {
        $variables['topic_articles'] = views_embed_view('articles_by_topic', 'block_1', $term->id());
      }
    }
  }

  if ($node instanceof NodeInterface && $node->bundle() === 'era_landing_page') {
    if ($node->hasField('field_era') && !$node->get('field_era')->isEmpty()) {
      $term = $node->get('field_era')->entity;
      if ($term && \Drupal::moduleHandler()->moduleExists('views') && _athenaeum_term_has_articles('field_era', $term->id())) {
        $variables['era_articles'] = views_embed_view('articles_by_era', 'block_1', $term->id());
      }
    }
  }

  if ($node instanceof NodeInterface && $node->bundle() === 'region_landing_page') {
    if ($node->hasField('field_region') && !$node->get('field_region')->isEmpty()) {
      $term = $node->get('field_region')->entity;
      if ($term && \Drupal::moduleHandler()->moduleExists('views') && _athenaeum_term_has_articles('field_region', $term->id())) {
        $variables['region_articles'] = views_embed_view('articles_by_region', 'block_1', $term->id());
      }
    }
  }
}

/**
 * Returns TRUE if any published featured article references the given term.
 *
 * Lets the landing-page templates fall through to their empty-state message
 * for terms with no articles (e.g. Antarctica, Space), since views_embed_view()
 * always returns a non-empty render array.
 */
function _athenaeum_term_has_articles(string $field, int $tid): bool {
  return (bool) \Drupal::entityQuery('node')
    ->accessCheck(TRUE)
    ->condition('type', 'featured_article')
    ->condition('status', 1)
    ->condition($field, $tid)
    ->range(0, 1)
    ->count()
    ->execute();
}

/**
 * Implements hook_preprocess_page().
 */
function athenaeum_preprocess_page(&$variables) {
  $variables['site_name'] = \Drupal::config('system.site')->get('name');
  $variables['current_year'] = date('Y');

  if (\Drupal::service('path.matcher')->isFrontPage()) {
    if (\Drupal::moduleHandler()->moduleExists('views')) {
      $variables['view_random_article'] = views_embed_view('random_article', 'block_1');
      $variables['view_recent_articles'] = views_embed_view('recent_articles', 'block_1');
    }
  }
}
